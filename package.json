{
  "name": "laag-plan",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "backend:run": "cd backend && .\\venv\\Scripts\\python manage.py runserver 8000",
    "backend:migrate": "cd backend && .\\venv\\Scripts\\python manage.py migrate",
    "backend:makemigrations": "cd backend && .\\venv\\Scripts\\python manage.py makemigrations",
    "dev": "concurrently -k \"npm run backend:run\" \"npm run frontend:dev\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
